# Copy to backend/.env and frontend/.env.local as needed (see comments).

# --- Shared database ---
# Postgres for FastAPI + seed script (DATABASE_URL or SUPABASE_DB_URL). Optional local CLI:
#   SUPABASE_URL=http://127.0.0.1:54321 maps Postgres to localhost:54322 after `supabase start`
# Hosted Supabase: paste Postgres URI from Dashboard -> Database (URL-encode special chars in password).
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are for REST/frontend later, not SQL clients.
DATABASE_URL=
# Supabase URI may include ?pgbouncer=true — psycopg strips it automatically (libpq does not accept it).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_DB_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# --- FastAPI (backend/.env) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature flags
ENABLE_AI_SCORING=false

# External APIs (optional for local dev)
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# Copernicus Data Space: set SENTINEL_HUB_USE_CDSE=true (see backend/.env.example)
SENTINEL_HUB_USE_CDSE=false

# IBM watsonx (optional)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_SPACE_ID=

# Toronto / ingestion defaults
TORONTO_BBOX=-79.65,43.58,-79.12,43.85
CITY_SLUG=toronto
# Optional: override Open Data GeoJSON URL if the portal link changes (seed script)
# TORONTO_GEOJSON_URL=
# Optional: seed script only — libpq connect timeout in seconds (default 60)
# SEED_DB_CONNECT_TIMEOUT=120

# Toronto street trees CKAN (scripts/seed_toronto_street_trees.py); usually defaults are enough.
# TORONTO_CKAN_BASE_URL=https://ckan0.cf.opendata.inter.prod-toronto.ca
# TORONTO_STREET_TREES_PACKAGE_ID=street-tree-data
# TORONTO_STREET_TREES_RESOURCE_ID=

# Toronto zoning overlay (scripts/seed_toronto_official_overlays.py --zoning).
# TORONTO_ZONING_BY_LAW_PACKAGE_ID=zoning-by-law
# TORONTO_ZONING_AREA_RESOURCE_ID=
# Flood GeoJSON path default for --flood (optional); else pass path on CLI.
# TORONTO_FLOOD_GEOJSON=scripts/data/Floodline_TRCA_Polygon.geojson

# Forest / land cover 2018 GDB (scripts/seed_toronto_land_cover.py — requires geopandas + pyogrio)
# TORONTO_FOREST_LAND_COVER_PACKAGE_ID=forest-and-land-cover

# --- Next.js (frontend/.env.local) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
