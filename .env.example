# CityLens — environment variables
# Copy this file:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
# Each service only reads the keys it needs; ignore the rest.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string (backend + seed script).
# Hosted Supabase: use the Session pool URI from Dashboard → Database (port 5432).
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000

# ── External data APIs (optional for local dev) ───────────────────────────────
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── IBM watsonx — AI scoring (optional) ───────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Featherless AI — block analysis (IBM Granite via Featherless) ─────────────
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Anthropic — petition drafting (Claude Haiku) ──────────────────────────────
ANTHROPIC_API_KEY=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
