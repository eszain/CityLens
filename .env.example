# Copy to backend/.env and frontend/.env.local as needed (see comments).

# --- Shared database ---
# Postgres for FastAPI + seed script (DATABASE_URL or SUPABASE_DB_URL). Optional local CLI:
#   SUPABASE_URL=http://127.0.0.1:54321 maps Postgres to localhost:54322 after `supabase start`
# Hosted Supabase: paste Postgres URI from Dashboard -> Database (URL-encode special chars in password).
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are for REST/frontend later, not SQL clients.
DATABASE_URL=
# Supabase URI may include ?pgbouncer=true — psycopg strips it automatically (libpq does not accept it).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_DB_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# --- FastAPI (backend/.env) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature flags
ENABLE_AI_SCORING=false

# External APIs (optional for local dev)
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# IBM watsonx (optional)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_SPACE_ID=

# Toronto / ingestion defaults
TORONTO_BBOX=-79.65,43.58,-79.12,43.85
CITY_SLUG=toronto
# Optional: override Open Data GeoJSON URL if the portal link changes (seed script)
# TORONTO_GEOJSON_URL=
# Optional: seed script only — libpq connect timeout in seconds (default 60)
# SEED_DB_CONNECT_TIMEOUT=120

# --- Next.js (frontend/.env.local) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
