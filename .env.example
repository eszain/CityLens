# Copy to backend/.env and frontend/.env.local as needed (see comments).

# --- Shared database (local PostGIS via infra/docker-compose.yml or Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- FastAPI (backend/.env) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature flags
ENABLE_AI_SCORING=false

# External APIs (optional for local dev)
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# IBM watsonx (optional)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_SPACE_ID=

# Toronto / ingestion defaults
TORONTO_BBOX=-79.65,43.58,-79.12,43.85
CITY_SLUG=toronto

# --- Next.js (frontend/.env.local) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
