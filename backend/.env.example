# --- Postgres (asyncpg uses this URL) ---
# Option A — explicit URI (hosted Supabase)
# Prefer Session pool (port 5432) for fewer driver quirks. Transaction pool (:6543) works too:
# FastAPI/asyncpg disables prepared-statement cache automatically on port 6543.
DATABASE_URL=

# Option B — same URI under another name (optional alias)
# SUPABASE_DB_URL=

# Option C — Local Supabase CLI: API URL only; Postgres defaults to 127.0.0.1:54322
# SUPABASE_URL=http://127.0.0.1:54321
#
# Hosted cloud: SUPABASE_* keys alone are NOT enough — you still need DATABASE_URL or
# SUPABASE_DB_URL via Dashboard -> Database (Postgres), not anon/service JWT.

# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (alias: SUPABASE_SERVICE_KEY)

CORS_ORIGINS=http://localhost:3000
ENABLE_AI_SCORING=false
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# true = Copernicus Data Space OAuth (identity.dataspace.copernicus.eu) + sh.dataspace catalog
# false = legacy services.sentinel-hub.com (default)
SENTINEL_HUB_USE_CDSE=false
# Optional overrides (both must be set if used):
# SENTINEL_HUB_OAUTH_URL=
# SENTINEL_HUB_CATALOG_SEARCH_URL=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
TORONTO_BBOX=-79.65,43.58,-79.12,43.85
